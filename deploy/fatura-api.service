[Unit]
Description=FaturaAI API
After=network.target fatura-extract.service
Wants=fatura-extract.service

[Service]
Type=simple
User=administrator
WorkingDirectory=/data/nanobaseai/fatura/apps/api
Environment=NODE_ENV=production
Environment=PORT=8105
Environment=ALLOWED_ORIGINS=https://portal.nanobase.ai
Environment=EXTRACT_V2_URL=http://127.0.0.1:8106
Environment=EXTRACT_V2_ENABLED=1
Environment=PDF_FAST_PATH=1
Environment=JOB_MAX_INFLIGHT=8
Environment=JOB_MAX_QUEUE=200
Environment=RATE_LIMIT_PER_MIN=600
Environment=RATE_LIMIT_BURST=80
Environment=MAX_UPLOAD_MB=20
Environment=JOB_DIR=/tmp/fatura-jobs
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=3
ExecStartPre=/bin/sleep 2
# Soft memory cap for Node API
MemoryMax=512M

[Install]
WantedBy=multi-user.target
